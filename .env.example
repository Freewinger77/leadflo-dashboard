# Server
PORT=8788
HOST=0.0.0.0

# Leadflo credentials (https://app.leadflo.com)
LEADFLO_EMAIL=arslan@tryrapidscreen.com
# Quote if password contains special chars (e.g. trailing backtick)
LEADFLO_PASSWORD="your-password"
LEADFLO_API_BASE=https://api.app.leadflo.com
LEADFLO_APP_ORIGIN=https://app.leadflo.com
# UK residential proxy recommended — datacenter + non-UK exits often WAF /auth/session
# LEADFLO_HTTP_PROXY=http://user:pass@host:port

# Only Implant treatment types are tracked
TRACKED_TREATMENT_TYPES=Implant

# Poll interval (ms). Default 60s.
POLL_INTERVAL_MS=60000

# Stages to scrape from /actions/due (comma-separated)
# newLead = New Leads, callback1/2/3 = Call Attempts, working = In Discussion
# Later stages are scraped for funnel reporting only.
SCRAPE_STAGES=newLead,callback1,callback2,callback3,working

# Stages allowed to trigger the outbound webhook. Discovery is deliberately
# wider than dispatch so funnel tracking never causes outbound contact.
WEBHOOK_STAGES=newLead,callback1,callback2,callback3,working

# How often a known lead's stage is re-checked, and how many per tick.
# Leads leave /actions/due once they progress, so without this their stage
# would stay frozen at whatever was last seen.
STAGE_REFRESH_INTERVAL_MS=900000
STAGE_REFRESH_BATCH_SIZE=25

# Outbound webhook — called for every NEW implant lead discovered
WEBHOOK_URL=
WEBHOOK_SECRET=

# Most webhooks one poll may dispatch. A new lead's webhook can end in a WhatsApp
# message, so this is what stops a mass rediscovery (lost database, widened
# SCRAPE_STAGES) becoming hundreds of sends in one minute. Leads over the cap are
# held and dispatched on later polls, so none are lost.
WEBHOOK_DISPATCH_CAP_PER_TICK=25

# --- WF-1 outbound feeder -----------------------------------------------
# Master switch. While false, /api/wf1/candidates still previews but
# /api/wf1/claim refuses to hand WF-1 a sendable batch.
OUTBOUND_ENABLED=false

# First live run must be capped and allowlisted. Numbers are digits with
# country code, comma separated (e.g. 447700900123).
OUTBOUND_ALLOWLIST_ONLY=true
OUTBOUND_ALLOWLIST=
OUTBOUND_MAX_PER_RUN=1
OUTBOUND_MAX_PER_DAY=5

# A claimed batch that never reports back is reclaimable after this.
OUTBOUND_LOCK_TTL_MS=900000

# Shared secret WF-1 sends as X-WF1-Key when claiming or reporting.
WF1_API_KEY=

# Country code assumed for local-format numbers.
OUTBOUND_COUNTRY_CODE=44

# Countries the practice will message unprompted. Numbers on OUTBOUND_ALLOWLIST
# bypass this, so a tester abroad does not need the policy widened.
OUTBOUND_ALLOWED_COUNTRIES=44

# When true, only write notes back to Leadflo for leads whose name contains "test"
# (safe for validating the loop without touching real patients)
NOTES_ONLY_TEST_NAMES=true

# Optional shared secret for inbound AI response webhook
INBOUND_WEBHOOK_SECRET=

# SQLite path
DATABASE_PATH=./data/leadflo.db

# Set to "mock" to run against fixtures (no live Leadflo calls)
# Useful when the API blocks datacenter IPs (AWS WAF often returns 403).
LEADFLO_MODE=live

# Optional HTTP(S) proxy if your host IP is WAF-blocked
# LEADFLO_HTTP_PROXY=http://user:pass@proxy-host:8080
