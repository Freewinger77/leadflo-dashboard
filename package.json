{
  "name": "leadflo-dashboard",
  "version": "1.0.0",
  "description": "Leadflo implant lead tracker \u2014 poll API, webhook new leads, write AI notes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "bash startup.sh",
    "build": "node -e \"console.log('build ok')\"",
    "test": "tsx --test tests/*.test.ts",
    "scrape:once": "tsx src/cli/scrape-once.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20 <24"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "tsx": "^4.19.3",
    "undici": "^6.21.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "typescript": "^5.8.3"
  }
}
